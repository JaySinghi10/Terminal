# Secrets — never commit
.env
.env.*
!.env.example
# A key pasted into a file to feed `gcloud secrets create --data-file`. The
# Dockerfile ends with `COPY . .`, so a key left here does not merely risk a
# commit -- it ships inside the image.
key.txt
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/

# Build output
dist/
build/
web-build/

# Expo
.expo/

# Vercel
.vercel/

# Binaries
*.exe
*.dll
*.so
*.dylib

# Provider API fixtures (raw responses; regenerate rather than commit)
samples/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
